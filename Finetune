   "execution_count": null,
   "outputs": [],
   "source": "from __future__ import annotations\n\n# ===== src/config.py =====\n\"\"\"Central configuration: paths, model ids, hyper-parameters, and free-tier budgets.\n\nEverything tunable lives here so the notebook and the CLI scripts stay thin and a run\nis reproducible from a single fixed seed.\n\"\"\"\n\nimport os\nimport random\nfrom dataclasses import dataclass, field\nfrom pathlib import Path\n\n# --------------------------------------------------------------------------------------\n# Paths. On Kaggle, /kaggle/working is the only directory persisted on \"Save & Run All\".\n# --------------------------------------------------------------------------------------\nREPO_ROOT = Path.cwd()\n\n\ndef _default_output_root() -> Path:\n    kaggle_working = Path(\"/kaggle/working\")\n    if kaggle_working.is_dir():\n        return kaggle_working\n    return REPO_ROOT\n\n\nOUTPUT_ROOT = Path(os.environ.get(\"FT_OUTPUT_ROOT\", _default_output_root()))\nDATA_DIR = OUTPUT_ROOT / \"data\"\nOUTPUTS_DIR = OUTPUT_ROOT / \"outputs\"\nADAPTER_DIR = OUTPUTS_DIR / \"adapter\"\nDATASET_PATH = DATA_DIR / \"dataset.jsonl\"\nTRAIN_PATH = DATA_DIR / \"train.jsonl\"\nVAL_PATH = DATA_DIR / \"val.jsonl\"\n\nSEED = 42\n\n# --------------------------------------------------------------------------------------\n# Model. Prefer the Unsloth 4-bit mirror; fall back to the upstream weights + load_in_4bit.\n# --------------------------------------------------------------------------------------\nMODEL_ID = os.environ.get(\"FT_MODEL_ID\", \"unsloth/gemma-4-E4B-it\")\nMODEL_ID_FALLBACK = \"google/gemma-4-E4B\"\nLOAD_IN_4BIT = True\n\n\n@dataclass\nclass TrainConfig:\n    # LoRA\n    lora_r: int = 16\n    lora_alpha: int = 16\n    lora_dropout: float = 0.0\n    target_modules: tuple[str, ...] = (\n        \"q_proj\", \"k_proj\", \"v_proj\", \"o_proj\",\n        \"gate_proj\", \"up_proj\", \"down_proj\",\n    )\n    # Sequence / batch. E4B is tighter on 16GB than E2B: drop max_seq_len first if it OOMs.\n    max_seq_len: int = 2048\n    per_device_batch_size: int = 1\n    grad_accumulation: int = 8\n    # Schedule (free-tier budget)\n    epochs: float = 2.0\n    max_steps: int = 200          # hard cap; whichever of epochs/max_steps is hit first\n    learning_rate: float = 2e-4\n    warmup_ratio: float = 0.05\n    weight_decay: float = 0.01\n    logging_steps: int = 5\n    seed: int = SEED\n\n\n@dataclass\nclass DataConfig:\n    # Final dataset budget, balanced across the three task types.\n    n_train: int = 300\n    n_val: int = 60\n    # Smoke mode produces a tiny dataset for fast end-to-end checks.\n    smoke_n_train: int = 12\n    smoke_n_val: int = 6\n    seed: int = SEED\n    # Mixing weights across task types (schema / html / tool_call).\n    task_mix: dict[str, float] = field(\n        default_factory=lambda: {\"schema\": 0.34, \"html\": 0.33, \"tool_call\": 0.33}\n    )\n\n\nTRAIN = TrainConfig()\nDATA = DataConfig()\n\n\ndef seed_everything(seed: int = SEED) -> None:\n    \"\"\"Seed python / numpy / torch when available. Safe to call before heavy imports.\"\"\"\n    random.seed(seed)\n    os.environ[\"PYTHONHASHSEED\"] = str(seed)\n    try:\n        import numpy as np\n\n        np.random.seed(seed)\n    except Exception:\n        pass\n    try:\n        import torch\n\n        torch.manual_seed(seed)\n        if torch.cuda.is_available():\n            torch.cuda.manual_seed_all(seed)\n    except Exception:\n        pass\n\n\ndef get_secret(name: str) -> str | None:\n    \"\"\"Read a secret from the environment or Kaggle Secrets, returning None if absent.\"\"\"\n    val = os.environ.get(name)\n    if val:\n        return val\n    try:\n        from kaggle_secrets import UserSecretsClient\n\n        return UserSecretsClient().get_secret(name)\n    except Exception:\n        return None\n\n\ndef ensure_dirs() -> None:\n    for d in (DATA_DIR, OUTPUTS_DIR, ADAPTER_DIR):\n        d.mkdir(parents=True, exist_ok=True)\n\n# ===== src/tools_schema.py =====\n\"\"\"Schemas for the three target behaviors.\n\nThese are the single source of truth used both to *generate* synthetic training data and\nto *validate* model output during evaluation:\n\n  * DECK_PLAN_SCHEMA -- the structured deck plan a \"schema\" example must satisfy.\n  * TOOL_SCHEMAS      -- per-tool argument schemas for the agent's tool surface.\n\nThe tool surface mirrors the orchestrator design: plan the deck, author animation HTML,\nrender it, inspect the render, then assemble the file.\n\"\"\"\n\nLAYOUTS = [\n    \"title\", \"title-bullets\", \"two-column\", \"section\",\n    \"image-focus\", \"quote\", \"chart\",\n]\nANIMATION_KINDS = [\n    \"none\", \"build-in\", \"diagram\", \"chart-grow\", \"highlight\", \"transition\",\n]\n\n# --------------------------------------------------------------------------------------\n# Deck plan\n# --------------------------------------------------------------------------------------\nDECK_PLAN_SCHEMA: dict = {\n    \"type\": \"object\",\n    \"additionalProperties\": False,\n    \"required\": [\"title\", \"slides\"],\n    \"properties\": {\n        \"title\": {\"type\": \"string\", \"minLength\": 1},\n        \"theme\": {\"type\": \"string\"},\n        \"slides\": {\n            \"type\": \"array\",\n            \"minItems\": 1,\n            \"items\": {\n                \"type\": \"object\",\n                \"additionalProperties\": False,\n                \"required\": [\"index\", \"title\", \"layout\", \"bullets\", \"needs_animation\"],\n                \"properties\": {\n                    \"index\": {\"type\": \"integer\", \"minimum\": 0},\n                    \"title\": {\"type\": \"string\", \"minLength\": 1},\n                    \"layout\": {\"enum\": LAYOUTS},\n                    \"bullets\": {\"type\": \"array\", \"items\": {\"type\": \"string\"}},\n                    \"needs_animation\": {\"type\": \"boolean\"},\n                    \"animation_kind\": {\"enum\": ANIMATION_KINDS},\n                },\n            },\n        },\n    },\n}\n\n# --------------------------------------------------------------------------------------\n# Agent tool surface\n# --------------------------------------------------------------------------------------\nTOOL_SCHEMAS: dict[str, dict] = {\n    \"plan_deck\": {\n        \"type\": \"object\",\n        \"additionalProperties\": False,\n        \"required\": [\"topic\"],\n        \"properties\": {\n            \"topic\": {\"type\": \"string\", \"minLength\": 1},\n            \"audience\": {\"type\": \"string\"},\n            \"max_slides\": {\"type\": \"integer\", \"minimum\": 1, \"maximum\": 40},\n        },\n    },\n    \"generate_animation_html\": {\n        \"type\": \"object\",\n        \"additionalProperties\": False,\n        \"required\": [\"slide_index\", \"animation_kind\"],\n        \"properties\": {\n            \"slide_index\": {\"type\": \"integer\", \"minimum\": 0},\n            \"animation_kind\": {\"enum\": ANIMATION_KINDS},\n            \"notes\": {\"type\": \"string\"},\n        },\n    },\n    \"render_animation\": {\n        \"type\": \"object\",\n        \"additionalProperties\": False,\n        \"required\": [\"slide_index\", \"html_ref\"],\n        \"properties\": {\n            \"slide_index\": {\"type\": \"integer\", \"minimum\": 0},\n            \"html_ref\": {\"type\": \"string\", \"minLength\": 1},\n        },\n    },\n    \"inspect_render\": {\n        \"type\": \"object\",\n        \"additionalProperties\": False,\n        \"required\": [\"slide_index\", \"render_ref\"],\n        \"properties\": {\n            \"slide_index\": {\"type\": \"integer\", \"minimum\": 0},\n            \"render_ref\": {\"type\": \"string\", \"minLength\": 1},\n        },\n    },\n    \"assemble_pptx\": {\n        \"type\": \"object\",\n        \"additionalProperties\": False,\n        \"required\": [\"output_name\"],\n        \"properties\": {\n            \"output_name\": {\"type\": \"string\", \"minLength\": 1},\n            \"include_slides\": {\"type\": \"array\", \"items\": {\"type\": \"integer\"}},\n        },\n    },\n}\n\nALLOWED_TOOLS = set(TOOL_SCHEMAS)\n\n# Wrapper schema for a single tool call emitted by the model.\nTOOL_CALL_SCHEMA: dict = {\n    \"type\": \"object\",\n    \"additionalProperties\": False,\n    \"required\": [\"name\", \"arguments\"],\n    \"properties\": {\n        \"name\": {\"enum\": sorted(ALLOWED_TOOLS)},\n        \"arguments\": {\"type\": \"object\"},\n    },\n}\n\n\ndef tools_description() -> str:\n    \"\"\"A compact human-readable tool list for system prompts.\"\"\"\n    lines = [\"Available tools:\"]\n    for name, schema in TOOL_SCHEMAS.items():\n        req = \", \".join(schema.get(\"required\", []))\n        lines.append(f\"- {name}(required: {req or 'none'})\")\n    return \"\\n\".join(lines)\n\n# ===== src/data/validate.py =====\n\"\"\"Pure-Python validators shared by data generation and evaluation.\n\nNo browser, no sandbox: deck plans and tool calls are validated with jsonschema; animation\nHTML is validated structurally (it parses, has the required container + script, balanced\nbraces). Each validator returns ``(ok: bool, reason: str)``.\n\"\"\"\n\nimport json\nimport re\nfrom html.parser import HTMLParser\n\nimport jsonschema\n\n\n_FENCE_RE = re.compile(r\"^\\s*```(?:json|html)?\\s*|\\s*```\\s*$\", re.IGNORECASE)\n\n\ndef strip_code_fence(text: str) -> str:\n    \"\"\"Remove a leading/trailing markdown code fence if the model wrapped its output.\"\"\"\n    return _FENCE_RE.sub(\"\", text.strip())\n\n\ndef _extract_json(text: str):\n    cleaned = strip_code_fence(text)\n    return json.loads(cleaned)\n\n\n# --------------------------------------------------------------------------------------\n# Deck plan\n# --------------------------------------------------------------------------------------\ndef validate_deck_plan(text: str) -> tuple[bool, str]:\n    try:\n        obj = _extract_json(text)\n    except Exception as exc:  # noqa: BLE001\n        return False, f\"json parse error: {exc}\"\n    try:\n        jsonschema.validate(obj, DECK_PLAN_SCHEMA)\n    except jsonschema.ValidationError as exc:\n        return False, f\"schema error: {exc.message}\"\n    indices = [s[\"index\"] for s in obj[\"slides\"]]\n    if indices != list(range(len(indices))):\n        return False, \"slide indices must be 0..n-1 in order\"\n    return True, \"ok\"\n\n\n# --------------------------------------------------------------------------------------\n# Tool call\n# --------------------------------------------------------------------------------------\ndef validate_tool_call(text: str) -> tuple[bool, str]:\n    try:\n        obj = _extract_json(text)\n    except Exception as exc:  # noqa: BLE001\n        return False, f\"json parse error: {exc}\"\n    try:\n        jsonschema.validate(obj, TOOL_CALL_SCHEMA)\n    except jsonschema.ValidationError as exc:\n        return False, f\"tool-call shape error: {exc.message}\"\n    name = obj[\"name\"]\n    if name not in ALLOWED_TOOLS:\n        return False, f\"unknown tool: {name}\"\n    try:\n        jsonschema.validate(obj[\"arguments\"], TOOL_SCHEMAS[name])\n    except jsonschema.ValidationError as exc:\n        return False, f\"args error for {name}: {exc.message}\"\n    return True, \"ok\"\n\n\n# --------------------------------------------------------------------------------------\n# Animation HTML\n# --------------------------------------------------------------------------------------\nclass _TagCollector(HTMLParser):\n    def __init__(self) -> None:\n        super().__init__()\n        self.tags: list[str] = []\n        self.ids: set[str] = set()\n        self.error: str | None = None\n\n    def handle_starttag(self, tag, attrs):  # noqa: D401\n        self.tags.append(tag)\n        for key, val in attrs:\n            if key == \"id\" and val:\n                self.ids.add(val)\n\n\ndef validate_animation_html(text: str) -> tuple[bool, str]:\n    html = strip_code_fence(text)\n    if not html.strip():\n        return False, \"empty html\"\n    parser = _TagCollector()\n    try:\n        parser.feed(html)\n    except Exception as exc:  # noqa: BLE001\n        return False, f\"html parse error: {exc}\"\n    if \"stage\" not in parser.ids:\n        return False, \"missing required <div id=\\\"stage\\\"> container\"\n    if \"script\" not in parser.tags:\n        return False, \"missing <script> block\"\n    if \"style\" not in parser.tags:\n        return False, \"missing <style> block\"\n    # Weak balance check on the script body (proxy for syntactically intact JS).\n    if html.count(\"{\") != html.count(\"}\"):\n        return False, \"unbalanced braces\"\n    if html.count(\"(\") != html.count(\")\"):\n        return False, \"unbalanced parentheses\"\n    return True, \"ok\"\n\n\nVALIDATORS = {\n    \"schema\": validate_deck_plan,\n    \"html\": validate_animation_html,\n    \"tool_call\": validate_tool_call,\n}\n\n\ndef validate_example(task_type: str, text: str) -> tuple[bool, str]:\n    if task_type not in VALIDATORS:\n        return False, f\"unknown task_type: {task_type}\"\n    return VALIDATORS[task_type](text)\n\n# ===== src/data/format_chat.py =====\n\"\"\"Turn a raw example into chat messages for the Gemma 4 chat template.\n\nThe system instruction is folded into the user turn rather than relying on a separate\n\"system\" role, which keeps formatting robust across chat-template variants. Training applies\n``tokenizer.apply_chat_template`` to these messages.\n\"\"\"\n\nSYSTEM_PROMPTS = {\n    \"schema\": (\n        \"You are a slide-deck planner. Given a topic, return ONLY a JSON deck plan that \"\n        \"matches the schema. No prose, no markdown fences.\"\n    ),\n    \"html\": (\n        \"You are a slide animator. Given a slide spec, return ONLY self-contained animation \"\n        \"HTML (a #stage container, a <style> block, and a seek-driven <script>). No prose.\"\n    ),\n    \"tool_call\": (\n        \"You are a slide-deck build orchestrator. Given the current state, return ONLY the \"\n        \"single next tool call as JSON with keys \\\"name\\\" and \\\"arguments\\\".\"\n    ),\n}\n\n\ndef to_messages(example: dict) -> list[dict]:\n    system = SYSTEM_PROMPTS[example[\"task_type\"]]\n    user = f\"{system}\\n\\n{example['prompt']}\"\n    return [\n        {\"role\": \"user\", \"content\": user},\n        {\"role\": \"assistant\", \"content\": example[\"target\"]},\n    ]\n\n\ndef to_prompt_messages(example: dict) -> list[dict]:\n    \"\"\"Messages for inference (user turn only) \u2014 used by evaluation.\"\"\"\n    system = SYSTEM_PROMPTS[example[\"task_type\"]]\n    user = f\"{system}\\n\\n{example['prompt']}\"\n    return [{\"role\": \"user\", \"content\": user}]\n\n# ===== src/data/seeds.py =====\n\"\"\"Procedural example generators + committed seed exemplars.\n\nThese are the *offline* data source: every example here is constructed to pass the\nvalidators in ``validate.py``, so the whole pipeline runs end-to-end with no API key. The\noptional teacher LLM only augments volume and diversity on top of this.\n\"\"\"\n\nimport json\nimport random\n\n\n# Word banks -----------------------------------------------------------------------------\nTOPICS = [\n    \"Retrieval-augmented generation\", \"Vector databases\", \"Kubernetes autoscaling\",\n    \"QLoRA fine-tuning\", \"Edge inference on mobile\", \"Graph neural networks\",\n    \"Observability for LLM apps\", \"Diffusion model basics\", \"Feature stores\",\n    \"Streaming data pipelines\", \"Zero-trust networking\", \"Reinforcement learning from feedback\",\n    \"Cost optimization on cloud GPUs\", \"Speech recognition pipelines\", \"Recommender systems\",\n    \"Time-series forecasting\", \"Prompt caching strategies\", \"On-device personalization\",\n]\nAUDIENCES = [\"engineers\", \"executives\", \"students\", \"researchers\", \"product managers\"]\nTHEMES = [\"midnight\", \"minimal-light\", \"neon\", \"corporate-blue\", \"warm-paper\"]\n\n_PALETTES = [\n    (\"#0b1020\", \"#e8ecff\", \"#5b8cff\"),\n    (\"#fafafa\", \"#1a1a1a\", \"#ff6b6b\"),\n    (\"#101418\", \"#d7ffe1\", \"#39ff88\"),\n    (\"#0a2540\", \"#ffffff\", \"#00d4ff\"),\n    (\"#f6f1e7\", \"#3a2f1b\", \"#d98a3d\"),\n]\n\n\n# Schema / deck-plan ---------------------------------------------------------------------\ndef _slide(index: int, title: str, layout: str, bullets: list[str], kind: str) -> dict:\n    needs = kind != \"none\"\n    slide = {\n        \"index\": index,\n        \"title\": title,\n        \"layout\": layout,\n        \"bullets\": bullets,\n        \"needs_animation\": needs,\n        \"animation_kind\": kind,\n    }\n    return slide\n\n\ndef generate_schema_example(rng: random.Random) -> dict:\n    topic = rng.choice(TOPICS)\n    audience = rng.choice(AUDIENCES)\n    theme = rng.choice(THEMES)\n    n_slides = rng.randint(4, 7)\n    slides = [_slide(0, topic, \"title\", [f\"For {audience}\"], \"build-in\")]\n    body_layouts = [l for l in LAYOUTS if l not in (\"title\", \"section\")]\n    for i in range(1, n_slides - 1):\n        layout = rng.choice(body_layouts)\n        kind = rng.choice(ANIMATION_KINDS)\n        bullets = [f\"Point {j + 1} about {topic.lower()}\" for j in range(rng.randint(2, 4))]\n        slides.append(_slide(i, f\"{topic}: part {i}\", layout, bullets, kind))\n    slides.append(_slide(n_slides - 1, \"Takeaways\", \"title-bullets\",\n                         [\"Recap\", \"Next steps\"], \"highlight\"))\n    plan = {\"title\": topic, \"theme\": theme, \"slides\": slides}\n    prompt = (\n        f\"Create a deck plan for the topic: \\\"{topic}\\\".\\n\"\n        f\"Audience: {audience}. Keep it to {n_slides} slides.\\n\"\n        \"Return only JSON matching the deck-plan schema.\"\n    )\n    target = json.dumps(plan, indent=2)\n    return {\"task_type\": \"schema\", \"prompt\": prompt, \"target\": target}\n\n\n# Animation HTML -------------------------------------------------------------------------\n_HTML_TEMPLATE = \"\"\"<div id=\"stage\" class=\"kind-__KIND__\">\n  <h1 class=\"title\">__TITLE__</h1>\n  <div class=\"bar\"></div>\n</div>\n<style>\n  #stage { position: relative; width: 1280px; height: 720px; background: __BG__;\n           font-family: system-ui, sans-serif; overflow: hidden; }\n  #stage .title { position: absolute; top: 280px; left: 80px; font-size: 64px;\n                  color: __FG__; opacity: 0; transform: translateY(24px); }\n  #stage .bar { position: absolute; bottom: 80px; left: 80px; height: 10px; width: 0;\n                background: __ACCENT__; }\n</style>\n<script>\n  (function () {\n    const stage = document.getElementById(\"stage\");\n    const title = stage.querySelector(\".title\");\n    const bar = stage.querySelector(\".bar\");\n    function seek(t) {\n      const p = Math.max(0, Math.min(1, t));\n      title.style.opacity = String(p);\n      title.style.transform = \"translateY(\" + (24 * (1 - p)) + \"px)\";\n      bar.style.width = (p * 100) + \"%\";\n    }\n    window.addEventListener(\"hf-seek\", function (e) { seek(e.detail.progress); });\n    seek(0);\n  })();\n</script>\"\"\"\n\n\ndef render_animation_html(title: str, kind: str, palette: tuple[str, str, str]) -> str:\n    bg, fg, accent = palette\n    return (\n        _HTML_TEMPLATE\n        .replace(\"__KIND__\", kind)\n        .replace(\"__TITLE__\", title)\n        .replace(\"__BG__\", bg)\n        .replace(\"__FG__\", fg)\n        .replace(\"__ACCENT__\", accent)\n    )\n\n\ndef generate_html_example(rng: random.Random) -> dict:\n    topic = rng.choice(TOPICS)\n    kind = rng.choice([k for k in ANIMATION_KINDS if k != \"none\"])\n    palette = rng.choice(_PALETTES)\n    title = f\"{topic}\"\n    prompt = (\n        f\"Write self-contained animation HTML for one slide.\\n\"\n        f\"Title: \\\"{title}\\\". Animation kind: {kind}.\\n\"\n        \"Use a <div id=\\\"stage\\\"> root, a <style> block, and a <script> that reacts to the \"\n        \"hf-seek event with detail.progress in [0,1].\"\n    )\n    target = render_animation_html(title, kind, palette)\n    return {\"task_type\": \"html\", \"prompt\": prompt, \"target\": target}\n\n\n# Tool calls -----------------------------------------------------------------------------\ndef _tool_call(name: str, arguments: dict) -> str:\n    return json.dumps({\"name\": name, \"arguments\": arguments}, indent=2)\n\n\ndef generate_tool_call_example(rng: random.Random) -> dict:\n    topic = rng.choice(TOPICS)\n    audience = rng.choice(AUDIENCES)\n    n_slides = rng.randint(4, 8)\n    stage = rng.choice(\n        [\"start\", \"needs_html\", \"needs_render\", \"needs_inspect\", \"ready_to_assemble\"]\n    )\n    idx = rng.randint(1, n_slides - 1)\n    kind = rng.choice([k for k in ANIMATION_KINDS if k != \"none\"])\n\n    if stage == \"start\":\n        state = f\"No plan exists yet. The user wants a deck about \\\"{topic}\\\" for {audience}.\"\n        target = _tool_call(\"plan_deck\",\n                            {\"topic\": topic, \"audience\": audience, \"max_slides\": n_slides})\n    elif stage == \"needs_html\":\n        state = (f\"The plan is ready ({n_slides} slides). Slide {idx} has \"\n                 f\"needs_animation=true (kind={kind}) but no HTML yet.\")\n        target = _tool_call(\"generate_animation_html\",\n                            {\"slide_index\": idx, \"animation_kind\": kind,\n                             \"notes\": \"follow the deck theme\"})\n    elif stage == \"needs_render\":\n        state = f\"Animation HTML for slide {idx} was authored but not yet rendered.\"\n        target = _tool_call(\"render_animation\",\n                            {\"slide_index\": idx, \"html_ref\": f\"slide_{idx}.html\"})\n    elif stage == \"needs_inspect\":\n        state = f\"Slide {idx} was rendered to slide_{idx}.png but not yet inspected for quality.\"\n        target = _tool_call(\"inspect_render\",\n                            {\"slide_index\": idx, \"render_ref\": f\"slide_{idx}.png\"})\n    else:\n        state = \"All slides are planned, animated, rendered, and inspected successfully.\"\n        target = _tool_call(\"assemble_pptx\",\n                            {\"output_name\": \"deck.pptx\",\n                             \"include_slides\": list(range(n_slides))})\n\n    prompt = (\n        \"You are orchestrating a slide-deck build. Current state:\\n\"\n        f\"{state}\\n\"\n        \"Emit the single next tool call as JSON with keys \\\"name\\\" and \\\"arguments\\\".\"\n    )\n    return {\"task_type\": \"tool_call\", \"prompt\": prompt, \"target\": target}\n\n\nGENERATORS = {\n    \"schema\": generate_schema_example,\n    \"html\": generate_html_example,\n    \"tool_call\": generate_tool_call_example,\n}\n\n\n# A few committed canonical exemplars (also used as teacher few-shot anchors).\nSEED_EXEMPLARS = [\n    generate_schema_example(random.Random(1)),\n    generate_html_example(random.Random(2)),\n    generate_tool_call_example(random.Random(3)),\n]\n\n# ===== src/data/teacher.py =====\n\"\"\"Optional free teacher LLM (Google AI Studio / Gemini) for dataset augmentation.\n\nThis is strictly optional: if no API key or the client library is missing, every function\ndegrades to ``None`` and ``build_dataset`` simply relies on the procedural generators. When\navailable, the teacher produces more natural/diverse *targets* for procedurally-sampled\nprompts; the caller still validates every output before keeping it.\n\"\"\"\n\n\nTEACHER_MODEL = \"gemini-2.0-flash\"\nTEACHER_TEMPERATURE = 0.6  # pinned for run-to-run stability\n\n_TASK_INSTRUCTIONS = {\n    \"schema\": (\n        \"Output ONLY JSON for a slide deck plan. It must have keys: title (string), theme \"\n        \"(string), slides (array). Each slide has: index (0-based, sequential), title, \"\n        \"layout, bullets (array of strings), needs_animation (bool), animation_kind.\"\n    ),\n    \"html\": (\n        \"Output ONLY self-contained animation HTML: a <div id=\\\"stage\\\"> root, a <style> \"\n        \"block, and a <script> that listens for the 'hf-seek' event and uses \"\n        \"event.detail.progress in [0,1] to drive the animation. No markdown fences.\"\n    ),\n    \"tool_call\": (\n        \"Output ONLY a JSON object with keys \\\"name\\\" and \\\"arguments\\\" representing the \"\n        \"single next tool call. Allowed tools: plan_deck, generate_animation_html, \"\n        \"render_animation, inspect_render, assemble_pptx.\"\n    ),\n}\n\n\ndef _exemplar_for(task_type: str) -> str:\n    for ex in SEED_EXEMPLARS:\n        if ex[\"task_type\"] == task_type:\n            return ex[\"target\"]\n    return \"\"\n\n\ndef _model():\n    key = get_secret(\"GOOGLE_API_KEY\")\n    if not key:\n        return None\n    try:\n        import google.generativeai as genai\n\n        genai.configure(api_key=key)\n        return genai.GenerativeModel(TEACHER_MODEL)\n    except Exception:\n        return None\n\n\ndef teacher_available() -> bool:\n    return _model() is not None\n\n\ndef generate_target(task_type: str, prompt: str) -> str | None:\n    \"\"\"Ask the teacher for a target given a prompt; return None on any failure.\"\"\"\n    model = _model()\n    if model is None or task_type not in _TASK_INSTRUCTIONS:\n        return None\n    full_prompt = (\n        f\"{_TASK_INSTRUCTIONS[task_type]}\\n\\n\"\n        f\"Example of a good output:\\n{_exemplar_for(task_type)}\\n\\n\"\n        f\"Now produce output for this request:\\n{prompt}\"\n    )\n    try:\n        import google.generativeai as genai\n\n        resp = model.generate_content(\n            full_prompt,\n            generation_config=genai.types.GenerationConfig(\n                temperature=TEACHER_TEMPERATURE,\n            ),\n        )\n        return (resp.text or \"\").strip() or None\n    except Exception:\n        return None\n\n# ===== src/data/build_dataset.py =====\n\"\"\"Build the SFT dataset: generate -> (optionally augment) -> validate -> dedupe -> split.\n\nRun as a module:\n\n    python -m src.data.build_dataset            # full dataset\n    python -m src.data.build_dataset --smoke    # tiny dataset + validator self-check\n\"\"\"\n\nimport json\nimport random\n\n\n\ndef _task_counts(total: int, mix: dict[str, float]) -> dict[str, int]:\n    counts = {k: int(total * w) for k, w in mix.items()}\n    # Distribute any rounding remainder to the first task types.\n    remainder = total - sum(counts.values())\n    for k in list(counts)[:remainder]:\n        counts[k] += 1\n    return counts\n\n\ndef _make_example(task_type: str, rng: random.Random, use_teacher: bool) -> dict | None:\n    base = GENERATORS[task_type](rng)\n    if use_teacher:\n        target = generate_target(task_type, base[\"prompt\"])\n        if target:\n            candidate = {**base, \"target\": target}\n            ok, _ = validate_example(task_type, target)\n            if ok:\n                return candidate\n    ok, reason = validate_example(task_type, base[\"target\"])\n    if not ok:\n        return None  # should not happen for procedural output; dropped defensively\n    return base\n\n\ndef build(n_train: int, n_val: int, seed: int) -> dict:\n    seed_everything(seed)\n    ensure_dirs()\n    rng = random.Random(seed)\n    total = n_train + n_val\n    counts = _task_counts(total, DATA.task_mix)\n    use_teacher = teacher_available()\n\n    examples: list[dict] = []\n    seen: set[tuple[str, str]] = set()\n    for task_type, n in counts.items():\n        made, attempts = 0, 0\n        while made < n and attempts < n * 20:\n            attempts += 1\n            ex = _make_example(task_type, rng, use_teacher)\n            if ex is None:\n                continue\n            key = (task_type, ex[\"target\"])\n            if key in seen:\n                continue\n            seen.add(key)\n            ex[\"messages\"] = to_messages(ex)\n            examples.append(ex)\n            made += 1\n\n    rng.shuffle(examples)\n    val = examples[:n_val]\n    train = examples[n_val:]\n\n    _write_jsonl(TRAIN_PATH, train)\n    _write_jsonl(VAL_PATH, val)\n    _write_jsonl(DATASET_PATH, examples)\n\n    summary = {\n        \"total\": len(examples),\n        \"train\": len(train),\n        \"val\": len(val),\n        \"per_task\": {t: sum(1 for e in examples if e[\"task_type\"] == t) for t in counts},\n        \"teacher_used\": use_teacher,\n    }\n    return summary\n\n\ndef _write_jsonl(path, rows: list[dict]) -> None:\n    with open(path, \"w\", encoding=\"utf-8\") as fh:\n        for row in rows:\n            fh.write(json.dumps(row, ensure_ascii=False) + \"\\n\")\n\n\n# Validator self-check -------------------------------------------------------------------\n_BAD_FIXTURES = [\n    (\"schema\", \"{not json\"),\n    (\"schema\", json.dumps({\"title\": \"x\", \"slides\": []})),          # empty slides\n    (\"tool_call\", json.dumps({\"name\": \"no_such_tool\", \"arguments\": {}})),\n    (\"tool_call\", json.dumps({\"name\": \"plan_deck\", \"arguments\": {}})),  # missing topic\n    (\"html\", \"<div>no stage, no script</div>\"),\n]\n\n\ndef self_check() -> bool:\n    ok_all = True\n    for ex in SEED_EXEMPLARS:\n        ok, reason = validate_example(ex[\"task_type\"], ex[\"target\"])\n        if not ok:\n            print(f\"  [FAIL] good {ex['task_type']} rejected: {reason}\")\n            ok_all = False\n    for task_type, text in _BAD_FIXTURES:\n        ok, _ = validate_example(task_type, text)\n        if ok:\n            print(f\"  [FAIL] bad {task_type} accepted: {text[:40]!r}\")\n            ok_all = False\n    print(\"  validator self-check:\", \"PASS\" if ok_all else \"FAIL\")\n    return ok_all\n\n# ===== src/train/train_qlora.py =====\n\"\"\"QLoRA fine-tune of Gemma 4 E4B with Unsloth.\n\nHeavy imports (unsloth / torch / trl) are deferred into functions so the rest of the package\nstays importable on a CPU-only box. Run as a module on a CUDA GPU:\n\n    python -m src.train.train_qlora\n\"\"\"\n\nimport json\nimport math\n\n\n\ndef _load_dataset(tokenizer):\n    from datasets import Dataset\n\n    rows = [json.loads(l) for l in open(TRAIN_PATH, encoding=\"utf-8\")]\n\n    def _to_text(row):\n        text = tokenizer.apply_chat_template(\n            row[\"messages\"], tokenize=False, add_generation_prompt=False\n        )\n        return {\"text\": text}\n\n    ds = Dataset.from_list(rows).map(_to_text, remove_columns=Dataset.from_list(rows).column_names)\n    return ds\n\n\ndef _load_model():\n    from unsloth import FastModel\n\n    try:\n        model, tokenizer = FastModel.from_pretrained(\n            model_name=MODEL_ID,\n            max_seq_length=TRAIN.max_seq_len,\n            load_in_4bit=LOAD_IN_4BIT,\n            full_finetuning=False,\n            token=get_secret(\"HF_TOKEN\"),\n        )\n    except Exception as exc:  # noqa: BLE001\n        print(f\"[warn] {MODEL_ID} failed ({exc}); trying {MODEL_ID_FALLBACK}\")\n        model, tokenizer = FastModel.from_pretrained(\n            model_name=MODEL_ID_FALLBACK,\n            max_seq_length=TRAIN.max_seq_len,\n            load_in_4bit=LOAD_IN_4BIT,\n            full_finetuning=False,\n            token=get_secret(\"HF_TOKEN\"),\n        )\n\n    model = FastModel.get_peft_model(\n        model,\n        r=TRAIN.lora_r,\n        lora_alpha=TRAIN.lora_alpha,\n        lora_dropout=TRAIN.lora_dropout,\n        target_modules=list(TRAIN.target_modules),\n        use_gradient_checkpointing=\"unsloth\",\n        random_state=TRAIN.seed,\n    )\n    return model, tokenizer\n\n\ndef train() -> str:\n    seed_everything(TRAIN.seed)\n    ensure_dirs()\n    from trl import SFTConfig, SFTTrainer\n\n    model, tokenizer = _load_model()\n    ds = _load_dataset(tokenizer)\n\n    bs, ga = TRAIN.per_device_batch_size, TRAIN.grad_accumulation\n    steps_per_epoch = max(1, math.ceil(len(ds) / (bs * ga)))\n    target_steps = math.ceil(TRAIN.epochs * steps_per_epoch)\n    max_steps = min(TRAIN.max_steps, target_steps)\n    print(f\"Training {len(ds)} examples | {steps_per_epoch} steps/epoch | max_steps={max_steps}\")\n\n    trainer = SFTTrainer(\n        model=model,\n        tokenizer=tokenizer,\n        train_dataset=ds,\n        args=SFTConfig(\n            dataset_text_field=\"text\",\n            max_seq_length=TRAIN.max_seq_len,\n            per_device_train_batch_size=bs,\n            gradient_accumulation_steps=ga,\n            warmup_ratio=TRAIN.warmup_ratio,\n            max_steps=max_steps,\n            learning_rate=TRAIN.learning_rate,\n            logging_steps=TRAIN.logging_steps,\n            optim=\"adamw_8bit\",\n            weight_decay=TRAIN.weight_decay,\n            lr_scheduler_type=\"linear\",\n            seed=TRAIN.seed,\n            output_dir=str(OUTPUTS_DIR / \"trainer\"),\n            report_to=\"none\",\n        ),\n    )\n\n    # Train on the model's responses only when the helper supports this template.\n    try:\n        from unsloth.chat_templates import train_on_responses_only\n\n        trainer = train_on_responses_only(\n            trainer,\n            instruction_part=\"<start_of_turn>user\\n\",\n            response_part=\"<start_of_turn>model\\n\",\n        )\n    except Exception as exc:  # noqa: BLE001\n        print(f\"[info] train_on_responses_only skipped: {exc}\")\n\n    trainer.train()\n\n    model.save_pretrained(str(ADAPTER_DIR))\n    tokenizer.save_pretrained(str(ADAPTER_DIR))\n    print(\"Saved adapter to\", ADAPTER_DIR)\n    _maybe_push_to_hub(model, tokenizer)\n    return str(ADAPTER_DIR)\n\n\ndef _maybe_push_to_hub(model, tokenizer) -> None:\n    repo = get_secret(\"HF_PUSH_REPO\")\n    token = get_secret(\"HF_TOKEN\")\n    if not (repo and token):\n        return\n    try:\n        model.push_to_hub(repo, token=token)\n        tokenizer.push_to_hub(repo, token=token)\n        print(\"Pushed adapter to\", repo)\n    except Exception as exc:  # noqa: BLE001\n        print(f\"[warn] hub push failed: {exc}\")\n\n# ===== src/eval/evaluate.py =====\n\"\"\"Before/after evaluation: base vs fine-tuned Gemma 4 E4B.\n\nLoads the base model, generates on the held-out val set, scores with the same validators used\nfor data, then repeats with the LoRA adapter applied (models are loaded one at a time to fit\nfree-tier GPU memory). Writes a metrics table and a side-by-side sample gallery.\n\n    python -m src.eval.evaluate\n\"\"\"\n\nimport gc\nimport json\n\n\nMAX_NEW_TOKENS = 1024\nGALLERY_N = 6  # examples shown side-by-side in the markdown report\n\n\ndef _read_val() -> list[dict]:\n    return [json.loads(l) for l in open(VAL_PATH, encoding=\"utf-8\")]\n\n\ndef _load(model_name: str):\n    from unsloth import FastModel\n\n    model, tokenizer = FastModel.from_pretrained(\n        model_name=model_name,\n        max_seq_length=TRAIN.max_seq_len,\n        load_in_4bit=LOAD_IN_4BIT,\n        token=get_secret(\"HF_TOKEN\"),\n    )\n    FastModel.for_inference(model)\n    return model, tokenizer\n\n\ndef _generate(model, tokenizer, example: dict) -> str:\n    inputs = tokenizer.apply_chat_template(\n        to_prompt_messages(example),\n        tokenize=True,\n        add_generation_prompt=True,\n        return_tensors=\"pt\",\n    ).to(model.device)\n    out = model.generate(input_ids=inputs, max_new_tokens=MAX_NEW_TOKENS, do_sample=False)\n    text = tokenizer.decode(out[0][inputs.shape[-1]:], skip_special_tokens=True)\n    return text.strip()\n\n\ndef _score(model, tokenizer, val: list[dict]) -> tuple[dict, list[str]]:\n    by_task: dict[str, list[bool]] = {}\n    outputs: list[str] = []\n    for ex in val:\n        text = _generate(model, tokenizer, ex)\n        ok, _ = validate_example(ex[\"task_type\"], text)\n        by_task.setdefault(ex[\"task_type\"], []).append(ok)\n        outputs.append(text)\n    rates = {t: round(sum(v) / len(v), 3) for t, v in by_task.items()}\n    flat = [ok for v in by_task.values() for ok in v]\n    rates[\"overall\"] = round(sum(flat) / len(flat), 3)\n    return rates, outputs\n\n\ndef _free(model) -> None:\n    del model\n    gc.collect()\n    try:\n        import torch\n\n        torch.cuda.empty_cache()\n    except Exception:\n        pass\n\n\ndef evaluate() -> dict:\n    ensure_dirs()\n    val = _read_val()\n\n    base_model, base_tok = _load(MODEL_ID)\n    base_rates, base_out = _score(base_model, base_tok, val)\n    _free(base_model)\n\n    tuned_model, tuned_tok = _load(str(ADAPTER_DIR))\n    tuned_rates, tuned_out = _score(tuned_model, tuned_tok, val)\n    _free(tuned_model)\n\n    metrics = {\"base\": base_rates, \"fine_tuned\": tuned_rates}\n    (OUTPUTS_DIR / \"eval_metrics.json\").write_text(json.dumps(metrics, indent=2))\n    _write_report(val, base_out, tuned_out, metrics)\n    print(\"Eval metrics:\", json.dumps(metrics, indent=2))\n    return metrics\n\n\ndef _trunc(text: str, n: int = 600) -> str:\n    return text if len(text) <= n else text[:n] + \"\\n\u2026 (truncated)\"\n\n\ndef _write_report(val, base_out, tuned_out, metrics) -> None:\n    lines = [\"# Before / after evaluation\", \"\", \"## Valid-output rate\", \"\",\n             \"| task | base | fine-tuned |\", \"| --- | --- | --- |\"]\n    tasks = sorted(set(metrics[\"base\"]) | set(metrics[\"fine_tuned\"]))\n    for t in tasks:\n        b = metrics[\"base\"].get(t, \"-\")\n        f = metrics[\"fine_tuned\"].get(t, \"-\")\n        lines.append(f\"| {t} | {b} | {f} |\")\n    lines += [\"\", \"## Sample gallery\", \"\"]\n    for ex, b, f in list(zip(val, base_out, tuned_out))[:GALLERY_N]:\n        lines += [\n            f\"### [{ex['task_type']}] {_trunc(ex['prompt'], 200)}\",\n            \"\", \"**Base:**\", \"```\", _trunc(b), \"```\",\n            \"**Fine-tuned:**\", \"```\", _trunc(f), \"```\", \"\",\n        ]\n    (OUTPUTS_DIR / \"eval_report.md\").write_text(\"\\n\".join(lines), encoding=\"utf-8\")\n    print(\"Wrote\", OUTPUTS_DIR / \"eval_report.md\")\n"
  },
